# FastSwap secrets only — copy to .env on each host. Non-secret config lives in FastSwapConfig.yaml.

# Set to 0 for Local Provider only (no live Rango/Rubic/Symbiosis/Transit HTTP).
# `npm run dev:local` sets this. Unset in production so live Providers are used.
# FASTSWAP_LIVE_PROVIDERS=0

# Execute plan signer (EIP-712). `dev:local` copies EVM_PRIVATE_KEY here.
# EXECUTE_PLAN_SIGNER_PRIVATE_KEY=

# Per-chain Execute relayer keys. `dev:local` copies EVM_PRIVATE_KEY to EXECUTE_ALICE_PRIVATE_KEY / EXECUTE_BOB_PRIVATE_KEY.
# EXECUTE_ALICE_PRIVATE_KEY=
# EXECUTE_BOB_PRIVATE_KEY=

# Rango (only used when live Providers are enabled)
# RANGO_API_KEY=

# API service (VPS)
API_SIGNING_SECRET=

# Optional: restrict CORS to your Vercel UI origin
# CORS_ORIGIN=https://your-app.vercel.app

# Sweep node — same signing secret so the node can authenticate to the API
SWEEP_EVM_PRIVATE_KEY=
SWEEP_TRON_PRIVATE_KEY=

# Relay node
RELAY_EVM_PRIVATE_KEY=
RELAY_TRON_PRIVATE_KEY=

# Liquidity manager bot
LM_PRIVATE_KEY=

# RPC endpoints (referenced from FastSwapConfig.yaml via ${...})
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=
TRON_FULL_HOST=

# DEX routers (LiquidityManager)
BASE_ROUTER_ADDRESS=
ARBITRUM_ROUTER_ADDRESS=
BSC_ROUTER_ADDRESS=

# Deploy CLI (operator workstation only — not on VPS nodes)
EVM_PRIVATE_KEY=
TRON_PRIVATE_KEY=
ETHERSCAN_API_KEY=
FASTSWAP_OWNER_ADDRESS=
