{
  "name": "fastswap",
  "version": "1.0.0",
  "description": "Fast Swap cross-chain protocol",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/build-onchain-invoice.mjs",
    "build": "tsc -p tsconfig.json",
    "compile": "hardhat compile",
    "test": "hardhat test test/*.ts test/system/*.ts",
    "clean": "hardhat clean",
    "server": "npm run build && node dist/server/main.js",
    "sweep": "npm run build && node dist/nodes/sweep-main.js",
    "execute": "npm run build && node dist/nodes/execute-node/main.js",
    "cli": "npm run build && node dist/cli/index.js",
    "readiness": "npm run build && node dist/cli/index.js --readiness",
    "cli:predict": "npm run build && node dist/cli/index.js --predict",
    "cli:verify": "npm run build && node dist/cli/index.js --verifyAll",
    "dev:local": "tsx scripts/dev-local.ts",
    "dev:pay": "tsx scripts/dev-pay.ts",
    "package": "bash package.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/fastswap.git"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "better-sqlite3": "^12.9.0",
    "ethers": "^6.16.0",
    "onchain-invoice": "github:naiemk/onchain-invoice#2526bef",
    "tronweb": "^6.3.0",
    "vibed-infra": "^0.5.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "ethers": "$ethers",
    "tronweb": "$tronweb"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.0.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "hardhat": "^3.4.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
