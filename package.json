{
  "name": "fastswap",
  "version": "1.0.0",
  "description": "Fast Swap cross-chain protocol",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run liqman:build",
    "compile": "hardhat compile",
    "test": "hardhat test test/*.ts test/system/*.ts LiquidityManager/test/*.ts",
    "clean": "hardhat clean",
    "server": "npm run build && node dist/server/main.js",
    "sweep": "npm run build && node dist/nodes/sweep-main.js",
    "relay": "npm run build && node dist/nodes/relay-node/main.js",
    "liqman:build": "tsc -p LiquidityManager/tsconfig.json",
    "liqman": "npm run liqman:build && node lm-dist/LiquidityManager/bot/index.js --fastswap-config FastSwapConfig.yaml",
    "cli": "npm run build && node dist/cli/index.js",
    "testnet": "npm run build && npm run liqman:build && node dist/cli/index.js --config FastSwapConfig.testnet.yaml",
    "testnet:launch": "npm run compile && npm run build && node dist/cli/index.js --config FastSwapConfig.testnet.yaml",
    "readiness": "npm run build && node dist/cli/index.js --readiness",
    "e2e-nodes": "npm run build && node dist/cli/testnet-e2e-nodes.js",
    "e2e-matrix": "npm run build && node dist/cli/testnet-e2e-matrix.js --config FastSwapConfig.testnet.yaml",
    "testnet:serve": "npm run build && node dist/cli/index.js --config FastSwapConfig.testnet.yaml --serve-only",
    "testnet:wallet": "node scripts/show-testnet-wallet.mjs",
    "testnet:wallet:new": "node scripts/generate-testnet-wallet.mjs && node scripts/show-testnet-wallet.mjs",
    "aggregate": "npm run build && node dist/nodes/aggregate-all/main.js",
    "cli:predict": "npm run build && node dist/cli/index.js --predict",
    "cli:verify": "npm run build && node dist/cli/index.js --verifyAll",
    "generate:testnet-config": "npx tsx scripts/generate-testnet-config.ts",
    "demo:build": "tsc -p fastSwapDemo/tsconfig.json",
    "demo": "node demo-dist/fastSwapDemo/start.js",
    "demo:pay": "node demo-dist/fastSwapDemo/pay-invoice.js",
    "demo:send": "node demo-dist/fastSwapDemo/pay.js",
    "integ": "npm run compile && npm run demo:build && node --env-file=fastSwapDemo/.env demo-dist/fastSwapDemo/integration/live-sepolia-tron.js",
    "docker:build": "docker compose -f docker/compose/api.yml -f docker/compose/nodes.yml build",
    "docker:up:api": "docker compose -f docker/compose/api.yml up -d",
    "docker:up:nodes": "docker compose -f docker/compose/api.yml -f docker/compose/nodes.yml up -d sweep relay liqman",
    "docker:up": "docker compose -f docker/compose/api.yml -f docker/compose/nodes.yml up -d",
    "docker:testnet:build": "docker compose -f docker/compose/testnet.yml build",
    "docker:testnet:up": "docker compose -f docker/compose/testnet.yml up -d",
    "docker:testnet:down": "docker compose -f docker/compose/testnet.yml down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naiemk/fastswap.git"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "@openzeppelin/contracts-upgradeable": "^5.6.1",
    "better-sqlite3": "^12.9.0",
    "ethers": "^6.16.0",
    "onchain-invoice": "file:../onchain-invoice",
    "tronweb": "^6.3.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "ethers": "$ethers",
    "tronweb": "$tronweb"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.10",
    "@nomicfoundation/hardhat-mocha": "^3.0.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "chai": "^6.2.2",
    "hardhat": "^3.4.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  }
}
